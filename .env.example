# Copy to .env and fill in. Never commit .env. This template stays blank.

# Required — the reasoning + vision engine
ANTHROPIC_API_KEY=

# Optional — structured ClaimReview data from Indian fact-checkers.
# Free key: https://console.cloud.google.com/  (enable "Fact Check Tools API")
GOOGLE_FACTCHECK_API_KEY=

# Optional — Indic-language speech-to-text (Phase 2 audio/video path)
SARVAM_API_KEY=

# Local SQLite file (Phase 1). Swap for a Postgres DSN in Phase 2.
DB_PATH=./data/verifier.db
